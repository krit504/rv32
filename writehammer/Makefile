# writehammer Makefile. Targets per spec Section 5. Run from this directory.
# Targets not yet implemented print "NOT IMPLEMENTED" with their task ID and fail, so nothing passes silently.

PY      := python3
VENV_PY := .venv/bin/python
RTL     := $(wildcard rtl/*.sv)
TOP     := rv32_top_pipelined
LATS    := 1 2 3 10
RUN     := scripts/run.sh --   # every result-producing command is logged to logs/runs/ (spec 0B.1)

.PHONY: all lint test arch-test random bench caches wear attacks calibrate eval synth plots \
        attacks-validate hypotheses locks locks-selftest audit clean arch-test test-nohazard test-hazard test-cache test-mem test-stall test-dcache test-invariant invariant caches test-subword test-perf test-toolchain test-arch-control test-mutants test-guard guard-integration

all: lint test arch-test random bench caches wear attacks calibrate eval synth plots hypotheses audit

lint:
	$(RUN) verilator --lint-only -Wall --top-module $(TOP) $(RTL)
	@echo "[lint] OK: 0 warnings, 0 errors"

test: locks test-mem test-stall test-dcache test-invariant test-nohazard test-hazard test-cache test-subword test-perf test-toolchain test-arch-control random bench test-mutants test-guard
	@echo "[test] OK"

test-nohazard:
	$(RUN) $(PY) tests/nohazard_test.py
	@for l in $(LATS); do CACHES=1 LAT=$$l $(RUN) $(PY) tests/nohazard_test.py || exit 1; done

test-hazard:
	$(RUN) $(PY) tests/hazard_tests.py --quiet
	$(RUN) $(PY) tests/hazard_tests.py --nofwd --quiet
	@for l in $(LATS); do CACHES=1 LAT=$$l $(RUN) $(PY) tests/hazard_tests.py --quiet || exit 1; \
	                      CACHES=1 LAT=$$l $(RUN) $(PY) tests/hazard_tests.py --nofwd --quiet || exit 1; done

test-cache:
	$(RUN) $(PY) tests/cache_integration.py

test-subword:
	$(RUN) $(PY) tests/refmodel_selftest.py
	$(RUN) $(PY) tests/subword_tests.py
	@for l in $(LATS); do CACHES=1 LAT=$$l $(RUN) $(PY) tests/subword_tests.py || exit 1; done

test-perf:
	$(RUN) $(PY) tests/perf_tests.py

test-toolchain:
	$(RUN) $(PY) tests/toolchain_test.py

# riscv-arch-test vs Spike. Caches off, then on at LAT 1 and 10 (the full latency matrix is T2.6).
arch-test:
	@printf '# ARCH TESTS RESULTS (T1.5)\n\nGenerated by `make arch-test` (tests/arch_test.py). Reference: Spike. Subset and exclusions: docs/ARCH_TESTS.md.\n' > docs/ARCH_TESTS_RESULTS.md
	ARCH_REPORT=docs/ARCH_TESTS_RESULTS.md $(RUN) $(PY) tests/arch_test.py
	@for l in 1 10; do CACHES=1 LAT=$$l ARCH_REPORT=docs/ARCH_TESTS_RESULTS.md $(RUN) $(PY) tests/arch_test.py || exit 1; done

test-arch-control:
	$(RUN) $(PY) tests/arch_mutant_check.py

# T1.6: 1000 random programs per configuration vs the reference model; the model itself is checked
# against Spike; known-bad cores must fail. Seeds 1..1000 (replay one with --start SEED --n 1).
random:
	$(RUN) $(PY) tests/random_spike_check.py --n 200
	$(RUN) $(PY) tests/random_lockstep.py --n 1000
	FWD=0 $(RUN) $(PY) tests/random_lockstep.py --n 1000
	@for l in 1 3 10; do CACHES=1 LAT=$$l $(RUN) $(PY) tests/random_lockstep.py --n 1000 || exit 1; done
	$(RUN) $(PY) tests/random_control.py

# T1.7/T1.8: benchmarks and benign workloads self-check (native oracles, bad-core controls), then the
# baseline table docs/baseline.md. About 4 minutes (Verilator).
bench:
	$(RUN) $(PY) tests/bench_test.py
	$(RUN) $(PY) tests/workload_test.py
	$(RUN) $(PY) analysis/baseline.py

test-mem:
	$(RUN) $(PY) tests/mem_model_test.py

# D$ vs the golden byte array and the independent Python cache model (Verilator, about 2.5 minutes)
test-dcache:
	$(RUN) $(PY) tests/dcache_test.py

# T2.2: random freezes and fetch bubbles injected into the hazard unit must not change any result
test-stall:
	$(RUN) $(PY) tests/stall_injection_test.py

# T2.6: the correctness invariant across cache and memory configurations. --quick (a third of the arch tests,
# 100 random programs) is part of `make test`; `make invariant` runs everything (several minutes more).
test-invariant:
	$(RUN) $(PY) tests/invariant_test.py --quick

invariant:
	$(RUN) $(PY) tests/invariant_test.py

# T2.7: cache-size and line-size sweeps, miss rates, stall breakdown, plots (analysis/caches.csv, caches_*.png)
caches:
	$(RUN) $(VENV_PY) analysis/caches.py

# T5.7: write_guard unit tests (RTL vs independent model, directed) and its mutants
test-guard:
	$(RUN) $(PY) tests/write_guard_test.py
	$(RUN) $(PY) tests/guard_mutants.py
	$(RUN) $(PY) tests/bypass_verify.py
	$(RUN) $(PY) tests/guard_integration.py --quick

# T5.8: every arm x every benchmark, attack and mixed image x latency 1, 20, random (needs `make attacks` images; about an hour)
guard-integration:
	$(RUN) $(PY) tests/guard_integration.py --csv work/guard_integration/results_full.csv

test-mutants:
	$(RUN) $(PY) tests/run_mutants.py

# Targets wired to the task that implements them. Until then each prints NOT IMPLEMENTED and fails.
wear:
	$(RUN) $(VENV_PY) analysis/wear_baseline.py
# T4 (T4.1-T4.6, T4.8): attack programs, their self-checks and broken-core controls, golden replays, mixed workloads,
# time to failure. Must pass. The T4.7 criterion is separate (below): it fails by its fixed rule, see DEC-010.
attacks:
	$(RUN) $(VENV_PY) tests/attack_lfsr.py
	$(RUN) $(VENV_PY) tests/attack_program.py --kind RLA --kind RTA --kind RnLA --kind RnTA
	$(RUN) $(VENV_PY) tests/attack_mutant_control.py --kind RLA --kind RTA --kind RnLA --kind RnTA
	$(RUN) $(VENV_PY) analysis/attack_runner.py
	$(RUN) $(VENV_PY) analysis/attack_replay_suite.py
	$(RUN) $(VENV_PY) analysis/attack_mixed.py
	$(RUN) $(VENV_PY) analysis/attack_tfail.py analysis/wear_baseline_f3a7ccb0eb4d.csv

# T4.7: each attack must show a higher PMR than every benign workload (fixed rule, spec 0A.B.5). Exits 1 today:
# 23 of 24 variants fail because benign crc32 has PMR(all) 127.94 of a possible 128. Not part of `make all`.
attacks-validate:
	$(RUN) $(VENV_PY) analysis/attack_validate.py --benign analysis/wear_baseline_f3a7ccb0eb4d.csv
	$(VENV_PY) analysis/attack_pmr_table.py analysis/wear_baseline_f3a7ccb0eb4d.csv analysis/attack_*_validation.csv

calibrate:
	$(RUN) $(VENV_PY) analysis/calibrate.py
eval:       ; @scripts/not_implemented.sh $@ T6.1
synth:      ; @scripts/not_implemented.sh $@ T6.5
plots:      ; @scripts/not_implemented.sh $@ T6.2
hypotheses: ; @scripts/not_implemented.sh $@ T6.3
audit:      ; @scripts/not_implemented.sh $@ T7.8

locks:
	$(RUN) scripts/check_locks.sh

# T0.6 acceptance: check_locks.sh must fail on tampering (runs on a throwaway copy).
locks-selftest:
	$(RUN) scripts/selftest_locks.sh

clean:
	rm -rf work obj_dir build
